  "slides": [
    {
      "slideId": "n5-l18-s1",
      "slideType": "grammar",
      "title": "1. Thể từ điển (辞書形)",
      "grammarFormula": "Vます → thể từ điển: 飲みます→飲む、食べます→食べる、来ます→来る、します→する",
      "explanation": "Thể từ điển là dạng NGUYÊN MẪU của động từ, dùng làm tên gọi tra từ điển và làm gốc cho nhiều cấu trúc ngữ pháp cao hơn thể ます. Quy tắc chuyển đổi tương ứng với 3 nhóm đã học.",
      "teacherTips": "Thể từ điển KHÔNG phải là 'thể suồng sã' như học sinh hay nhầm — nó chỉ là dạng gốc dùng để tra từ điển và ghép ngữ pháp.",
      "culturalNotes": "Sách ngữ pháp và từ điển Nhật LUÔN liệt kê động từ ở thể từ điển, không bao giờ ở thể ます.",
      "examples": [
        {
          "id": "ex-n5-l18-s1-1",
          "tokens": [
            {
              "id": "t-l18s1-1",
              "text": "およぎます",
              "isKeyGrammar": false,
              "kanji": "泳ぎます",
              "furigana": "およぎます"
            },
            {
              "id": "t-l18s1-2",
              "text": "→",
              "isKeyGrammar": false
            },
