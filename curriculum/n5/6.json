  "slides": [
    {
      "slideId": "n5-l6-s1",
      "slideType": "grammar",
      "title": "1. Tha động từ: N[tân ngữ] + を + V",
      "grammarFormula": "[Danh từ] + を + Vます",
      "explanation": "を đánh dấu ĐỐI TƯỢNG chịu tác động trực tiếp của động từ — đọc là お, không phải を(wo) như chữ viết. Đây là trợ từ RIÊNG cho tha động từ, khác hẳn は (chủ đề) hay が (chủ ngữ).",
      "teacherTips": "を luôn đọc お dù viết bằng chữ を — cùng nhóm ngoại lệ đọc với は/へ đã học.",
      "culturalNotes": "会います (gặp) tuy có tân ngữ là người nhưng lại dùng に, không dùng を — đây là ngoại lệ cần nhớ riêng.",
