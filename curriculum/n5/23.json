  "slides": [
    {
      "slideId": "n5-l23-s1",
      "slideType": "grammar",
      "title": "1. Mốc thời điểm: [Thể thông thường] とき、V",
      "grammarFormula": "V(từ điển)/V(た)/A/N-の + とき、[hành động]",
      "explanation": "とき (khi, lúc) đứng sau MỆNH ĐỀ THỜI ĐIỂM ở thể thông thường — động từ, tính từ, hay danh từ (thêm の) đều ghép được. Chọn từ điển hay た tùy hành động đó XẢY RA TRƯỚC hay SAU mốc.",
      "teacherTips": "Mẹo phân biệt: V(từ điển)+とき = hành động CHƯA xảy ra tại mốc; V(た)+とき = hành động ĐÃ xảy ra tại mốc.",
      "culturalNotes": "子供のとき (hồi còn nhỏ) và 学生のとき (hồi còn đi học) là cách mở đầu câu chuyện quá khứ rất phổ biến trong hội thoại Nhật.",
      "examples": [
