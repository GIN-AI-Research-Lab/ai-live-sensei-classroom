  "slides": [
    {
      "slideId": "n5-l19-s1",
      "slideType": "grammar",
      "title": "1. Chia thể た (giống hệt quy tắc thể て, đổi て→た)",
      "grammarFormula": "Nhóm 1: 5 kiểu biến âm giống thể て / Nhóm 2: bỏ ます + た / Nhóm 3 bất quy tắc",
      "explanation": "Thể た chia HỆT thể て đã học ở bài 14 — chỉ cần đổi て→た, で→だ ở mọi vị trí. Nếu đã thuộc thể て thì thể た gần như không cần học lại từ đầu.",
      "teacherTips": "Học thể た gần như MIỄN PHÍ nếu đã nắm chắc thể て ở bài 14 — chỉ đổi て/で thành た/だ.",
      "culturalNotes": "Thể た còn gọi là 'thể ngắn quá khứ' (普通形), dùng trong văn viết thân mật, nhật ký, và làm gốc cho rất nhiều ngữ pháp N4 trở lên.",
      "examples": [
        {
