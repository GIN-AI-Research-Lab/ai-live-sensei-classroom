              "isKeyGrammar": false
            },
            {
              "id": "t-l11s1-5",
              "text": "あいたくて",
              "isKeyGrammar": true,
              "kanji": "会いたくて",
              "furigana": "あいたくて"
            },
            {
              "id": "t-l11s1-6",
