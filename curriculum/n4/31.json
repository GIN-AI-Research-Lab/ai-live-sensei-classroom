  "slides": [
    {
      "slideId": "n4-l31-s1",
      "slideType": "grammar",
      "title": "1. Chia thể ý chí (意向形)",
      "grammarFormula": "Nhóm 1: う→おう (行こう) 　Nhóm 2: bỏ る+よう (食べよう) 　する→しよう 　来る→来よう",
      "explanation": "Thể ý chí diễn tả Ý ĐỊNH/QUYẾT TÂM của NGƯỜI NÓI — gần nghĩa với Vましょう (N5 bài 6) nhưng thân mật hơn, thường dùng khi tự nói với mình hoặc trong câu và思っています.",
      "teacherTips": "Thể ý chí thân mật hơn Vましょう rất nhiều — dùng với bạn thân, hoặc tự nhủ với bản thân, không dùng trực tiếp với người trên.",
      "culturalNotes": "頑張ろう！ là câu hô hào đồng đội rất phổ biến trong thể thao, câu lạc bộ học sinh Nhật trước một trận đấu/sự kiện.",
      "examples": [
