# Sao chep file nay thanh .env roi dien API key that vao (KHONG commit .env).
#   cp .env.example .env
#
# Lay key tai: https://aistudio.google.com/apikey
#
# key1 -> phien Sensei (Gemini Live: giang bai, doi thoai truc tiep qua audio)
# key2 -> dan dien vien long tieng + soan de (goi model van ban, tao giong doc)
#
# Hai key co the trung nhau (dung 1 key cho ca hai) hoac tach rieng de
# chia tai quota giua phien Live va cac tac vu nen. Neu chi dien mot trong
# hai, server.py se tu dung chung key con lai cho ca hai vai tro.
GEMINI_KEY1=
GEMINI_KEY2=
