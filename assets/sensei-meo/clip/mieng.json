 "feather": {"sides_bottom": 7.0, "top_near_nose": 4.5, "rule": "alpha = smoothstep(clamp(khoang cach vao trong tu bien da giac / feather, 0, 1)); feather noi suy 4.5->5.5->7 px theo y 258->268->280"},
 "core_bbox": [226.0, 256.0, 343.0, 302.5],
 "lam_mem": {"sigma_px_2x": 0.7, "rau": "rau o hai goc tren (hop cac vet sang dai, top-hat > 10, |goc| <= 40 do, cua moi o): giu nguyen trong loi dac, tren dai vien mem thay dan bang anh opening 9x9 tung kenh; trong so giu rau = smoothstep(0.6, 0.95, alpha) - cung mot ban do cho moi o", "cung_dem_trai": "vung x 224-246, y 255-276 (mep mem 4 px): tuong phan giam 60% (tron ve anh loc thap sigma 3 px, bo qua pixel mom toi / moi hong cua tung o)"},
 "bao_ve_mau": {"cong_thuc": "d = max(gb(p+(-h,-h)), gb(p+(h,-h)), gb(p+(-h,h)), gb(p+(h,h))) voi gb(q) = video(q).g - video(q).b, h = 0.5 texel video (4 mau song tuyen); e = ((xr-284.5)/40)^2 + ((yr-282)/17)^2; w = smoothstep(0.8, 1.1, e); alpha_phu *= 1.0 - w*smoothstep(0.075, 0.11, d). (xr,yr) = toa do tham chieu cua diem anh lop phu (cung (xr,yr) dung cho gain): trong elip long mom (e < 0.8) KHONG bao ve mau, tu e 0.8 -> 1.1 bao ve dan len day du.", "v": "video = texel da giai ma (0..1, chua nhan alpha nen) tai CUNG diem anh ma lop phu ve; dang tron cheo 2 clip thi dung mau da tron. Nhan vao ca rgb va alpha cua mau o da nhan alpha", "ly_do": "khi dau quay, mieng dan tren ma phai va long cam o ma lot vao vien mat na (tay-trai 178/360 khung): long trang duoi mat na g-b p99 0.067, mieng dan / long cam g-b >= 0.11 (p1); nen xanh (g-b ~ 0.44) cung duoc che. Cac cho can che deu o ngoai elip (goc tren, duoi mui, mieng dan). Rang / diem sang tren moi cua video hoi vang (vd. noi-kin #240 RGB 208,208,186, g-b ~ 0.086) nen neu bao ve ca trong long mom thi lo rang video thanh vet sang giua long mom toi cua o (noi-kin #240, #293-299; tay-phai #180-190) -> elip tat bao ve o do (mo phong 3 clip x 7 o: 0 lo; phan son len mieng dan / long cam van 0 nhu ban cu). Lay max 4 mau lech nua texel = no nhe 1 px de mep mieng dan min, khong rang cua.", "bat_buoc": true},
 "khuyen_nghi_do_mo": {"van_de": "tron tuyen tinh kin -> a/e/i/o voi t 0.25-0.5 ve ra mom xam trong suot (long mom toi nua dac chong len duong mieng kin). Tron giua 2 khau hinh mo (a -> o, e -> i ...) thi dep.", "cach_lam": "t = smoothstep(0.15, 0.6, mo). mo_rong(X): X thuoc a/e/i/o -> t < 0.5: mix(kin, o2, 2t), t >= 0.5: mix(o2, X, 2t-1) (o2 lam buoc trung gian, khong co mom xam); X = o2 hoac u -> mix(kin, X, t); X = kin -> kin. Ket qua = mix(mo_rong(a), mo_rong(b), t_ab) voi (a, b, t_ab) cua SenseiKhauHinh.layLuc (tron cheo 40-60 ms giu nguyen). Moi phep mix lam tren mau o DA nhan alpha.", "cap_kin": "Dung mot ben (a hoac b) la kin thi mix(mo_rong(X), kin, t_ab) van ra mom xam (1 khung o moi lan khep / mo). Renderer (sensei-cat-video.js trongSo) coi cap do la doc do mo: mo_rong(X) voi t = smoothstep(0.15, 0.6, mo) * (b = kin ? 1 - t_ab : t_ab) -> kin -> o2 -> X; chi hai ben deu mo moi tron theo t_ab.", "bat_buoc": false},
 "nguon": {"kin": "khung tham chieu", "a": "gemini-2.5-flash-image a3_1", "e": "gemini-2.5-flash-image e_0", "i": "gemini-2.5-flash-image i_2", "o": "gemini-2.5-flash-image o3_0", "u": "gemini-2.5-flash-image u_1", "o2": "gemini-2.5-flash-image o2_2"},
