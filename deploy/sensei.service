# sensei.service — systemd unit cho AI Live Sensei Classroom tren VPS.
#
# Cai dat (xem huong dan day du trong deploy/README.md):
#   sudo cp deploy/sensei.service /etc/systemd/system/sensei.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sensei
#
# Dieu kien truoc:
#   - Da tao user he thong rieng:  sudo useradd --system --home /srv/sensei --shell /usr/sbin/nologin sensei
#     (user nay cung la chu so huu thu muc /srv/sensei; neu user SSH deploy la user khac
#      thi phai bao dam user do ghi duoc vao /srv/sensei de git pull hoat dong)
#   - Repo da clone vao /srv/sensei, da co .env va da chay tools/setup_vendor.py mot lan.
#
# Mac dinh server.py chi nghe localhost (khong co --lan) — dung y do:
# ben ngoai di qua reverse proxy (nginx/Caddy) o cong 80/443, xem deploy/README.md.

[Unit]
Description=AI Live Sensei Classroom (server.py)
After=network.target

[Service]
Type=simple
User=sensei
Group=sensei
WorkingDirectory=/srv/sensei
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
